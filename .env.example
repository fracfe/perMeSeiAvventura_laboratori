# Solo esempi: sostituire tutte le credenziali prima dell'uso.
# Questo file non viene caricato automaticamente dall'app.
# Il compose locale usa valori espliciti in environment: copiare questo file
# non li cambia. Configurare esplicitamente l'ambiente dei servizi.

# Applicazione web (MariaDB). DB_HOST=db funziona nella rete Compose.
DB_TYPE=mariadb
DB_HOST=db
DB_PORT=3306
DB_NAME=example_event_db
DB_USER=example_event_user
DB_PASSWORD=CHANGE_ME_example_app_password
SECRET_KEY=CHANGE_ME_example_secret_key_not_for_real_use

# Opzionale: true per cookie di sessione trasmessi solo via HTTPS.
# false per il test locale HTTP; default applicativo false.
SESSION_COOKIE_SECURE=false

# Container MariaDB: inizializzazione di un volume vuoto.
# Nome DB e credenziali applicative devono coincidere con DB_NAME/USER/PASSWORD.
# Queste variabili non cambiano gli account di un DB gia' inizializzato.
MARIADB_DATABASE=example_event_db
MARIADB_USER=example_event_user
MARIADB_PASSWORD=CHANGE_ME_example_app_password
MARIADB_ROOT_PASSWORD=CHANGE_ME_example_root_password
TZ=Europe/Rome
